# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.py    text diff=python
*.md    text
*.toml  text
*.yml   text
*.spec  text diff=python

# Windows launchers must keep CRLF or cmd.exe mis-parses them.
*.bat   text eol=crlf

*.png   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.db    binary
